NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # local-dev only — run `supabase status -o env` to get the deterministic dev key
# Web UI and API are co-hosted in Next.js. Same-origin fetches require no value.
# Set this only when calling the API cross-origin (e.g. mobile dev hitting a deployed API).
NEXT_PUBLIC_API_URL=

# Strava integration (Phase A foundations; Phases B-D consume these).
# OAuth app credentials from https://www.strava.com/settings/api -- never inline in shell history.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# AES-256-GCM token encryption keys. Format: `1:<64-hex>,2:<64-hex>,...`.
# Highest-numbered version is used for new encryptions; older versions
# remain decryptable for rotation. To generate a key without leaving it in
# shell history, see docs/solutions/strava-token-crypto.md (the file is
# written 0600, sourced, then shredded).
STRAVA_TOKEN_KEYS=
# Verify token registered with Strava when subscribing the webhook (Phase D).
STRAVA_WEBHOOK_VERIFY_TOKEN=
# HMAC-SHA256 key for the OAuth state nonce
# (apps/web/src/strava/state-nonce.ts). 32 random bytes hex-encoded.
# Generate without leaving the value in shell history:
#   `openssl rand -hex 32 > .signing-key && \
#    cat .signing-key | pbcopy && shred -u .signing-key`
# Required in production -- the connect route refuses to verify state
# without it.
STRAVA_OAUTH_STATE_SIGNING_KEY=

# Inngest queue layer. In local dev with `pnpm --filter @da2/web dev:inngest`
# the SDK auto-discovers the dev server and these can be left empty.
# In production the values come from https://app.inngest.com.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
