# Public (browser-safe).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Server-only. These must be set in any environment where the API runs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification. Project uses ES256 / asymmetric (verified in Unit 0 preflight).
# JWKS_URL defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json if unset.
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUD=authenticated

# Strava token encryption (AES-256-GCM via Web Crypto).
# Comma-separated "<version>:<64-hex>" pairs; the highest version encrypts;
# all listed versions decrypt. Each key must be exactly 32 bytes (= 64 hex
# characters). Generate: openssl rand -hex 32
# Example: STRAVA_TOKEN_KEYS=1:00112233...,2:ffeeddcc...
STRAVA_TOKEN_KEYS=

# Cron secret for /api/cron/* — Vercel sends this in the Authorization header.
# Generate: openssl rand -base64 32
CRON_SECRET=

# Test database (used by Vitest harness).
DATABASE_URL_TEST_SYNC=postgresql://postgres:postgres@localhost:54322/da2_test

APP_ENV=development
LOG_LEVEL=info

# CORS allowlist for the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# TrustedHost allowlist for production (comma-separated). Required in non-dev.
TRUSTED_HOSTS=

# Optional observability.
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
