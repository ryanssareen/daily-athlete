FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.0 /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev || uv sync --no-dev

COPY src ./src

# src/jobs/worker.py lands in Wave 2 (Strava webhook hydration). Until then this
# image is a placeholder for the worker-process scaffolding (deployed on the
# container PaaS chosen in Unit 1.5); running it should fail loudly rather than
# silently appear to work.
CMD ["sh", "-c", "echo 'da2 worker not yet implemented (Wave 2 deliverable)' && exit 1"]
