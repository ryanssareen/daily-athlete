APP_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql+asyncpg://da2:da2_dev@localhost:54322/da2
DATABASE_URL_SYNC=postgresql://da2:da2_dev@localhost:54322/da2

# Used by tests; defaults to a "_test" suffix on the DATABASE_URL DB.
DATABASE_URL_TEST=postgresql+asyncpg://da2:da2_dev@localhost:54322/da2_test
DATABASE_URL_TEST_SYNC=postgresql://da2:da2_dev@localhost:54322/da2_test

REDIS_URL=redis://localhost:6379/0

# Supabase JWT signing secret (used to verify tokens from the Supabase Auth service).
# In local Supabase CLI, find via `supabase status`.
SUPABASE_JWT_SECRET=local-jwt-secret-replace-me

# Strava token encryption key (32 bytes hex).
STRAVA_TOKEN_KEY=replace-with-32-bytes-of-randomness-from-secrets-token-hex-32

STRAVA_RAW_RETENTION_DAYS=30

SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
