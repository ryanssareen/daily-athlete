# Node
node_modules/
.next/
.turbo/
.expo/
dist/
build/
out/
*.tsbuildinfo
next-env.d.ts

# Package managers
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.uv-cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Env
.env
.env.local
.env.*.local
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.pem

# Secrets — never commit
*.p8
secrets/AuthKey_*
secrets/*.key
secrets/.env*

# Supabase
supabase/.branches
supabase/.temp

# Vercel
.vercel

# Logs
*.log
logs/
# ...but NOT source route/page dirs under the Next app that are legitimately
# named "logs" (e.g. /admin/logs, /api/admin/logs) — those are code, not output.
!apps/web/app/**/logs/
!apps/web/app/**/logs/**

# Coverage
coverage/
.coverage
htmlcov/
/.context/
