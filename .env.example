# Root-level env vars copied/symlinked into each app as needed.
# Each app also has its own .env.example with app-specific keys.

# Local Postgres (docker-compose, or `supabase start` for the full local stack)
DATABASE_URL=postgresql://da2:da2_dev@localhost:54322/da2

# Supabase (set when wiring real Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Strava token encryption — versioned hex keys; highest version is used for new writes,
# all listed versions tried for decryption. See AGENTS.md "Secrets" for rotation.
STRAVA_TOKEN_KEYS=v1:replace-me-with-32-bytes-of-randomness

# Strava OAuth (set when wiring real Strava app)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Strava raw payload retention (days)
STRAVA_RAW_RETENTION_DAYS=30

# LLM providers (set when AI features are wired)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Background jobs (Inngest by default per Unit 1.5)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Subscriptions
REVENUECAT_WEBHOOK_SECRET=

# App-level
NODE_ENV=development
