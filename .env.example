# Root-level env vars copied/symlinked into each app as needed.
# Each app also has its own .env.example with app-specific keys.

# Local Postgres (docker-compose)
DATABASE_URL=postgresql+asyncpg://da2:da2_dev@localhost:54322/da2
DATABASE_URL_SYNC=postgresql://da2:da2_dev@localhost:54322/da2

# Local Redis (Arq queue)
REDIS_URL=redis://localhost:6379/0

# Supabase (set when wiring real Supabase project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Strava token encryption (32-byte random; required in any env that touches strava_tokens)
STRAVA_TOKEN_KEY=replace-me-with-32-bytes-of-randomness

# Strava OAuth (set when wiring real Strava app)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Strava raw payload retention (days)
STRAVA_RAW_RETENTION_DAYS=30

# LLM providers (set when AI features are wired)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Subscriptions
REVENUECAT_WEBHOOK_SECRET=

# App-level
APP_ENV=development
LOG_LEVEL=info
