{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js (web)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@da2/web", "dev"],
      "port": 3000
    },
    {
      "name": "Inngest dev server",
      "runtimeExecutable": "npx",
